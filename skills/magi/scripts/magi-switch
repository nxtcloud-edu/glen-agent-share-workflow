#!/usr/bin/env bash
# MAGI 노드 간 tmux 세션 전환 — 키바인딩에서 호출한다.
#
#   magi-switch <노드 key> [폴백 윈도우 번호]
#
# 세션명이 `<프로젝트>-<노드>` 규칙이므로, 현재 세션명에서 마지막 마디만 갈아끼우면
# 같은 프로젝트의 다른 노드가 된다 (edu-workflow-hermes → edu-workflow-claude).
#
# MAGI 세션이 아니거나 대상이 없으면 **폴백 윈도우로 넘긴다** — prefix+1/2/3의 기본 동작
# (윈도우 전환)을 일반 tmux 사용에서 빼앗지 않기 위해서다.
set -euo pipefail

NODE="${1:?사용법: magi-switch <claude|hermes|codex> [폴백 윈도우 번호]}"
FALLBACK="${2:-}"

fallback() {
  [ -n "$FALLBACK" ] && tmux select-window -t "$FALLBACK" 2>/dev/null || true
  exit 0
}

CUR=$(tmux display-message -p '#S' 2>/dev/null) || fallback
case "$CUR" in
  *-claude|*-hermes|*-codex) ;;   # MAGI 세션 규칙에 맞을 때만 전환한다
  *) fallback;;
esac

TARGET="${CUR%-*}-$NODE"
[ "$TARGET" = "$CUR" ] && exit 0   # 이미 그 노드

if tmux has-session -t "$TARGET" 2>/dev/null; then
  tmux switch-client -t "$TARGET"
else
  tmux display-message "MAGI: $TARGET 세션 없음 (magi $NODE 로 기동)"
fi
